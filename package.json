{
  "name": "prism",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Prism — a browser extension that makes confusing websites beautiful, understandable and easy to use.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/fixtures-server.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "secret-scan": "node scripts/secret-scan.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@streamparser/json": "^0.0.26",
    "fflate": "^0.8.3",
    "preact": "^11.0.0",
    "zod": "^4.6.5"
  }
}
