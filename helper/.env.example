# Prism helper configuration — no secrets live here.
# Google credentials come from Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
PRISM_MODE=local            # "hosted" on Cloud Run (stricter limits, Origin required)
PRISM_MODEL=gemini-3.8-flash
PRISM_FALLBACK_MODEL=gemini-3.5-flash-lite
